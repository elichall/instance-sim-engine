# =========================
# C++ & CMake Build Files
# =========================
# Ignore the entire build directory (contains your executables, Makefiles, and object files)
build/
.cache/
compile_commands.json

# =========================
# Python Environment
# =========================
# Ignore the virtual environment folder (this contains thousands of Python system files)
venv/
env/

# Ignore Python cache files (generated automatically when Python runs)
__pycache__/
*.py[cod]
*$py.class

# =========================
# Simulation Output Data
# =========================
# Ignore generated CSVs so you don't accidentally push 2GB of physics data to GitHub


# (Optional) If you want to keep ONE small sample CSV to prove the script works, 
# you can force Git to track it by adding an exclamation point:
# !sample_performance.csv

# =========================
# OS & Editor Files
# =========================
.vscode/
.DS_Store